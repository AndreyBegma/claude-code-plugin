{
  "version": "1.15.0",
  "description": "Configuration for Claude Code Analyzer Plugin",
  "exclusions": {
    "directories": [
      "node_modules",
      "dist",
      ".next",
      "build",
      "coverage",
      ".git",
      ".cache",
      ".vscode",
      ".idea"
    ],
    "files": [
      "*.lock",
      "*.log",
      ".DS_Store",
      "Thumbs.db"
    ],
    "patterns": [
      "**/@generated/**",
      "**/*.d.ts",
      "**/migrations/**",
      "**/seeds/**"
    ]
  },
  "dead-code": {
    "enabled": true,
    "skipDependencyCheck": false,
    "skipUnusedExports": false,
    "skipEnvironmentVars": false,
    "minFilesToAnalyze": 10
  },
  "security": {
    "enabled": true,
    "checkSecrets": true,
    "checkInjection": true,
    "checkAuthentication": true,
    "checkInputValidation": true,
    "secretPatterns": {
      "aws": "AKIA[0-9A-Z]{16}",
      "github": "ghp_[0-9a-zA-Z]{36}",
      "stripe": "sk_live_[0-9a-zA-Z]{24,}",
      "generic_private_key": "-----BEGIN (RSA |EC )?PRIVATE KEY-----"
    }
  },
  "orchestrator": {
    "base": "develop",
    "maxSlots": 5,
    "readyLabel": "cs:ready",
    "specDir": null,
    "install": null,
    "checks": [
      "python3 skills/orchestrator/scripts/fence_test.py",
      "python3 skills/orchestrator/scripts/emit_test.py",
      "python3 skills/orchestrator/scripts/dispatch_test.py",
      "python3 skills/orchestrator/scripts/spec_dir_test.py",
      "bash skills/orchestrator/scripts/wiring_test.sh",
      "bash -n skills/orchestrator/scripts/dispatch.sh",
      "bash -n skills/orchestrator/scripts/watch.sh",
      "bash -n skills/init/scaffold.sh"
    ],
    "mergeMethod": "merge",
    "autoMerge": true,
    "defaultModel": "sonnet",
    "triageSkill": null
  }
}
